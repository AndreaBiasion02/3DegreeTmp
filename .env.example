NEXT_PUBLIC_SITE_URL=https://3degreelab.com
# Server only: copy this file to .env.local. Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Global daily request cap (UTC), including failed upstream attempts. 0 disables AI.
COASTER_DAILY_LIMIT=300
COASTER_HOURLY_LIMIT=10
# Cooldown between consecutive requests from the same client IP in seconds. 0 disables cooldown.
COASTER_COOLDOWN_SECONDS=10
# Set to the exact public origin behind a reverse proxy, no trailing slash.
# COASTER_ALLOWED_ORIGIN=https://3degreelab.com
