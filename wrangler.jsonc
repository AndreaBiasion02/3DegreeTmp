{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3degreetmp",
  "main": "server/worker.mjs",
  "compatibility_date": "2024-09-23",
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "COASTER_DAILY_LIMIT": "300",
    "COASTER_HOURLY_LIMIT": "10",
    "COASTER_COOLDOWN_SECONDS": "10",
    "NEXT_PUBLIC_SITE_URL": "https://3degreelab.com"
  },
  "durable_objects": { "bindings": [{ "name": "COASTER_QUOTA", "class_name": "CoasterQuota" }] },
  "migrations": [{ "tag": "v1-coaster-quota", "new_sqlite_classes": ["CoasterQuota"] }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
